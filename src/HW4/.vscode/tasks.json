{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Build and Test",
            "type": "shell",
            "command": "./compile_and_test.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}