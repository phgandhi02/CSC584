{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Graph Analysis (gdb) Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/graph_analysis",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}/app/graph_analysis.cpp",
                "${workspaceFolder}/src/*.cpp", // <-- Adjust this path as needed
                "-o",
                "${workspaceFolder}/build/bin/graph_analysis" // Use workspaceFolder variable
            ],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "SFML Demo (gdb) Launch",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/sfml_demo",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}/app/sfml_demo.cpp",
                "${workspaceFolder}/src/*.cpp", // <-- Adjust this path as needed
                "-o",
                "${workspaceFolder}/build/bin/sfml_demo" // Use workspaceFolder variable
            ],
            "stopAtEntry": false,
            "cwd": "${fileDirname}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}