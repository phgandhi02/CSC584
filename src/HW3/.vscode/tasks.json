{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Build and Test",
            "type": "shell",
            "command": "cmake -S . -B build && cmake --build build && cd build && ctest",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Run Main",
            "type": "shell",
            "command": "./build/bin/main",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "none",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}