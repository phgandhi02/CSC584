{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Build and Test",
            "type": "shell",
            "command": "cmake -S . -B build && cmake --build build && cd build && ctest",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Build Graph Analysis (gdb)",
            "type": "shell",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-g",
                "${workspaceFolder}/app/graph_analysis.cpp",
                "${workspaceFolder}/src/graph.cpp",
                "${workspaceFolder}/src/pathfinding_algos.cpp",
                "${workspaceFolder}/src/heuristic.cpp",
                "-o",
                "${workspaceFolder}/build/bin/graph_analysis"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "Build SFML Demo (gdb)",
            "type": "shell",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-I/usr/local/include",
                "-L/usr/local/lib",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system",
                "-g",
                "${workspaceFolder}/app/sfml_demo.cpp",
                "${workspaceFolder}/src/graph.cpp",
                "${workspaceFolder}/src/pathfinding_algos.cpp",
                "${workspaceFolder}/src/heuristic.cpp",
                "-o",
                "${workspaceFolder}/build/bin/sfml_demo"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}